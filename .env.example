# ═══════════════════════════════════════════════════════════════════════
# EMPIRE V49 · ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════
# Copy this to .env and fill in your values. Never commit .env to git.
#
# Required vars have no default — set them before starting.
# Optional vars have sensible defaults shown in comments.
#
# Deployment: `dokku config:set empire-ai-uk KEY=value`
# Local dev:   edit .env (gitignored) and run: source .env
# ═══════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════
# 🔴 REQUIRED FOR PRODUCTION
# ═══════════════════════════════════════════════════════════════════════

# Shared secret for WebSocket connections (legacy token auth)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_TOKEN=

# Shared secret for /webhook/lead inbound webhooks (default dev: empire_v49_secret)
WEBHOOK_SECRET=

# Admin token for /api/admin/seed (default dev: no auth)
ADMIN_TOKEN=

# Public-facing base URL
PUBLIC_BASE_URL=https://empire-ai.co.uk


# ═══════════════════════════════════════════════════════════════════════
# 🔴 SUPABASE
# ═══════════════════════════════════════════════════════════════════════
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key


# ═══════════════════════════════════════════════════════════════════════
# 🔴 AI PROVIDERS
# ═══════════════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...


# ═══════════════════════════════════════════════════════════════════════
# 🔴 VONAGE VOICE API
# ═══════════════════════════════════════════════════════════════════════
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_NUMBER=+18005550199
VONAGE_PRIVATE_KEY_PATH=/app/vonage_private.key
EMPIRE_OPERATOR_NUMBER=+12145559999


# ═══════════════════════════════════════════════════════════════════════
# 🟡 EMAIL (Resend)
# ═══════════════════════════════════════════════════════════════════════
RESEND_API_KEY=re_...
FROM_ADDRESS=ops@empire-ai.co.uk
FROM_NAME=Empire AI
EMPIRE_POSTAL_ADDRESS=Empire AI Ltd · United Kingdom
EMPIRE_SENDER_NAME=Empire AI Operations
EMPIRE_EMAIL_RATE=12


# ═══════════════════════════════════════════════════════════════════════
# 🟡 SOLANA / PAYOUTS
# ═══════════════════════════════════════════════════════════════════════
SOLANA_SIGNING_KEY=
USDC_WALLET=
USDC_OPS_WALLET=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
EMPIRE_SOLANA_NETWORK=mainnet-beta
EMPIRE_SOLANA_COMMITMENT=confirmed
EMPIRE_SOLANA_TIMEOUT_SEC=30
EMPIRE_PAYOUT_AUTO_USD=0


# ═══════════════════════════════════════════════════════════════════════
# 🟡 SYSTEM CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════
EMPIRE_SMS_PREFIX=Empire AI:
EMPIRE_SMS_RATE=6
PULSE_REFRESH_INTERVAL_SEC=300
PULSE_DEFAULT_WINDOW=24h
EMPIRE_BRIDGE_ENABLED=true
EMPIRE_BRIDGE_LISTEN_MODE=continuous
NTFY_TOPIC=
NTFY_TOKEN=
SI_FEED_CACHE_TTL_SECONDS=300
TOKEN_SECRET=empire-v49
DRY_RUN=


# ═══════════════════════════════════════════════════════════════════════
# 🟢 OPTIONAL — LOCAL DEV
# ═══════════════════════════════════════════════════════════════════════
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_MODEL_PRIMARY=llama3.2:3b
OLLAMA_MODEL_BACKUP=llama3.1:latest
LOG_LEVEL=INFO
EMPIRE_TESTING=1
SECRET_KEY=

# AI Router model mappings
AI_DEFAULT_MODEL=llama3.2:3b
AI_MODEL_DECIDE=llama3.2:3b
AI_MODEL_QUALIFY=llama3.2:3b
AI_MODEL_ENRICH=llama3.2:3b
AI_MODEL_NARRATE=llama3.2:3b
AI_MODEL_DRAFT=llama3.1:latest
AI_MODEL_BRIEFING=qwen2.5-coder:14b
AI_MAX_CONCURRENT=2
AI_TIMEOUT_SEC=90


# ═══════════════════════════════════════════════════════════════════════
# 🟢 OPTIONAL — STORM PIPELINE / SATELLITE / SWARM / DREAM
# ═══════════════════════════════════════════════════════════════════════
STORM_POLL_INTERVAL_SEC=300
STORM_LANE_COUNT=6
STORM_MAX_SENDS_PER_HOUR=50
STORM_MAX_SENDS_PER_DAY=200
STORM_BOUNCE_BREAKER_PCT=5
HOURLY_DIGEST_PATH=/root/empire-v49/hourly_digest.txt
DIGEST_INTERVAL_MINUTES=60.0

SATELLITE_LOOKBACK_HOURS=24
SATELLITE_MIN_RISK_RANK=4
SATELLITE_MAX_PACKAGES=32
SWARM_WORKER_INTERVAL_HOURS=6.0
SWARM_MESH_POLL_SEC=30
SWARM_LANE_COUNT=3
SWARM_LANE_TIMEOUT_SEC=120
SWARM_AUTOPILOT_INTERVAL_SEC=1800

AGI_LANE_INTERVAL_SEC=60
AGI_REVENUE_INTERVAL_SEC=3600
HERMES_CTL_INTERVAL_SEC=60
HERMES_CTL_LOOKBACK_MIN=10
MESH_LOOP_INTERVAL_SEC=30

DREAM_INTERVAL_HOURS=6.0
DREAM_MODEL=llama3.1:latest
DREAM_MAX_TOKENS=800
SEO_INTERVAL_HOURS=6.0

WHALE_FALLBACK_NUMBER=+18005550199
EMPIRE_MAX_SENDS_PER_NUMBER_PER_DAY=3


# ═══════════════════════════════════════════════════════════════════════
# 🟢 OPTIONAL — THIRD-PARTY INTEGRATIONS
