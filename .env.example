# ═══════════════════════════════════════════════════════════════════════
# EMPIRE V49 · ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# ═══════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>           # service_role (not anon)
SUPABASE_ANON_KEY=<anon-key>                      # optional, for client-side

# ── Ollama (local LLM) ────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b                          # primary model
OLLAMA_MODEL_PRIMARY=llama3.2:3b                  # nightly benchmark
OLLAMA_MODEL_BACKUP=llama3.1:latest               # fallback model
AI_MODEL_DRAFT=llama3.1:latest                    # outreach drafting
AI_MODEL_ENRICH=llama3.2:3b                       # enrichment/default

# ── Vonage (Voice) ────────────────────────────────────────────────────
VONAGE_API_KEY=<api-key>
VONAGE_API_SECRET=<api-secret>
VONAGE_APPLICATION_ID=231873a5-68d1-4028-8ffb-000853072332
VONAGE_NUMBER=12142277528
VONAGE_PRIVATE_KEY_PATH=/root/empire-v49/private.key

# ── Solana (Payouts) ──────────────────────────────────────────────────
USDC_WALLET=<vault-wallet-pubkey>                 # vault receives settlements
USDC_OPS_WALLET=<ops-wallet-pubkey>               # operations share sent here
SOLANA_SIGNING_KEY=<base58-encoded-private-key>   # ⚠ NEVER IN GIT
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
EMPIRE_SOLANA_NETWORK=devnet                      # devnet | mainnet-beta
EMPIRE_SOLANA_COMMITMENT=confirmed                # processed | confirmed | finalized
EMPIRE_SOLANA_TIMEOUT_SEC=30
EMPIRE_PAYOUT_AUTO_USD=0                          # 0=manual only, e.g. 500=auto under $500

# ── API Keys ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=<anthropic-key>                 # Claude (console, inbound)
OPENAI_API_KEY=<openai-key>                       # Whisper, brain memory

# ── Empire AI Closer ──────────────────────────────────────────────────
CLOSER_AGI_STREAM_THRESHOLD=0.7                   # AGI stream call threshold
CLOSER_STATIC_CALL_THRESHOLD=0.4                  # static call threshold
CLOSER_DEFAULT_VOICE=am_michael                   # am_michael | af_sarah

# ── Synthetic Brain (Kokoro TTS) ──────────────────────────────────────
SYNTHETIC_BRAIN_URL=http://127.0.0.1:8005
SYNTHETIC_BRAIN_API_KEY=<brain-api-key>
SYNTHETIC_BRAIN_HOST=127.0.0.1
SYNTHETIC_BRAIN_PORT=8005
SYNTHETIC_BRAIN_LOG_LEVEL=info
SYNTHETIC_BRAIN_WS_MAX_SIZE=20971520              # 20MB max WS message

# ── Voice Streaming Agent ─────────────────────────────────────────────
STREAM_CONFIDENCE_THRESHOLD=0.7                   # stream vs static routing
VOICE_STREAMING_INTERVAL_HOURS=0.5                # streaming cycle interval
EMPIRE_OPERATOR_NUMBER=<operator-phone>           # fallback + monitoring

# ── Swarm Worker ──────────────────────────────────────────────────────
SWARM_WORKER_INTERVAL_HOURS=6.0                   # fleet fire interval
SWARM_MESH_POLL_SEC=30                            # mesh queue poll interval
SWARM_LANE_COUNT=3                                # concurrent lanes
SWARM_LANE_TIMEOUT_SEC=120                        # per-lane timeout
SWARM_AUTOPILOT_INTERVAL_SEC=1800                  # swarm autopilot scan interval (30min)

# ── Satellite Strike Core ────────────────────────────────────────────
SATELLITE_LOOKBACK_HOURS=24                       # storm forecast lookback window
SATELLITE_MIN_RISK_RANK=4                         # minimum risk rank (4=Slight)
SATELLITE_MAX_PACKAGES=32                         # max strike packages per scan

# ── AGI Governor + Lanes ─────────────────────────────────────────────
AGI_LANE_INTERVAL_SEC=60                          # lane processing interval
AGI_REVENUE_INTERVAL_SEC=3600                     # revenue computation interval

# ── Hermes Controller ─────────────────────────────────────────────────
HERMES_CTL_INTERVAL_SEC=60                        # controller loop interval
HERMES_CTL_LOOKBACK_MIN=10                        # task lookback window
MESH_LOOP_INTERVAL_SEC=30                         # agent mesh loop interval

# ── Empire Dream (Nightly Analysis) ───────────────────────────────────
DREAM_INTERVAL_HOURS=6.0                          # dream cycle interval
DREAM_MODEL=llama3.1:latest                       # deeper analysis model
DREAM_MAX_TOKENS=800                              # response token limit

# ── Email (Resend) ────────────────────────────────────────────────────
FROM_ADDRESS=noreply@empire-ai.co.uk              # sender email
FROM_NAME=Empire AI Operations                     # sender name
EMPIRE_POSTAL_ADDRESS=Empire AI Ltd · UK
EMPIRE_SENDER_NAME=Empire AI Operations

# ── SMS ───────────────────────────────────────────────────────────────
EMPIRE_MAX_SENDS_PER_NUMBER_PER_DAY=3             # compliance rate limit

# ── Inbound / Switchboard ─────────────────────────────────────────────
WHALE_FALLBACK_NUMBER=+18005550199                # fallback when no buyer

# ── Storm Orchestrator ────────────────────────────────────────────────
STORM_POLL_INTERVAL_SEC=300                       # storm forecast poll interval
STORM_LANE_COUNT=6                                # concurrent outreach lanes
STORM_MAX_SENDS_PER_HOUR=50                       # hourly send cap
STORM_MAX_SENDS_PER_DAY=200                       # daily send cap
STORM_BOUNCE_BREAKER_PCT=5                        # bounce rate threshold %

# ── SEO Agent ─────────────────────────────────────────────────────────
SEO_INTERVAL_HOURS=6.0                            # SEO cycle interval

# ── Google APIs ──────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=<maps-api-key>
GOOGLE_KG_API_KEY=<kg-api-key>                    # reuses MAPS key by default

# ── Reddit Pulse ──────────────────────────────────────────────────────
REDDIT_CLIENT_ID=<client-id>
REDDIT_CLIENT_SECRET=<client-secret>
REDDIT_USERNAME=<username>
REDDIT_PASSWORD=<password>
REDDIT_USER_AGENT=EmpireAI/1.0

# ── Mapbox ────────────────────────────────────────────────────────────
MAPBOX_TOKEN=<mapbox-token>

# ── Proxy Rotation ────────────────────────────────────────────────────
EMPIRE_PROXIES=                                   # comma-separated proxy URLs

# ── Notifications (ntfy) ──────────────────────────────────────────────
NTFY_TOPIC=                                       # ntfy.sh topic
NTFY_TOKEN=                                       # ntfy auth token

# ── WhisperX (Quality Analyst) ────────────────────────────────────────
WHISPERX_MODEL=base                               # tiny | base | small | medium | large
WHISPERX_DEVICE=cpu                               # cpu | cuda
WHISPERX_BATCH_SIZE=8
WHISPERX_COMPUTE_TYPE=int8                        # int8 | float16

# ── Stream Registry ───────────────────────────────────────────────────
STREAM_REGISTRY_BACKEND=                          # empty=dict, "redis"=Redis
REDIS_URL=                                        # redis://localhost:6379

# ── Hourly Digest ─────────────────────────────────────────────────────
HOURLY_DIGEST_PATH=/root/empire-v49/hourly_digest.txt
DIGEST_INTERVAL_MINUTES=60.0

# ── Nightly Model Benchmark ────────────────────────────────────────────
OLLAMA_PORT=8005
BENCHMARK_N_CALLS=20
SUCCESS_THRESHOLD=0.70
CONSECUTIVE_NIGHTS=3

# ── AI Router (per-pipeline model mapping) ────────────────────────────
AI_DEFAULT_MODEL=llama3.2:3b                     # fallback for un-mapped pipelines
AI_MAX_CONCURRENT=2                               # max concurrent LLM calls
AI_TIMEOUT_SEC=90                                 # LLM call timeout
AI_MODEL_DECIDE=llama3.2:3b                       # brain.decide pipeline
AI_MODEL_QUALIFY=llama3.2:3b                      # reply.qualify pipeline
AI_MODEL_ENRICH=llama3.2:3b                       # enricher.extract pipeline
AI_MODEL_NARRATE=llama3.2:3b                      # narrate.event pipeline
AI_MODEL_DRAFT=llama3.1:latest                    # email.draft pipeline
AI_MODEL_BRIEFING=qwen2.5-coder:14b               # mission.briefing pipeline

# ── Security ──────────────────────────────────────────────────────────
SECRET_KEY=<random-64-char-string>                # JWT session signing
HUB_TOKEN=<random-token>                          # shared auth token (legacy + WebSocket)
ADMIN_TOKEN=<admin-token>                         # /api/admin/seed guard
EMPIRE_TESTING=                                   # set to "1" to gate module-level I/O
WEBHOOK_SECRET=                                    # webhook signature verification

# ── Networking ────────────────────────────────────────────────────────
EMPIRE_PUBLIC_BASE_URL=                           # public URL for callbacks (overrides)
PUBLIC_BASE_URL=http://localhost:8000             # internal API URL

# ── Pulse View (Insight Layer) ────────────────────────────────────────
PULSE_REFRESH_INTERVAL_SEC=300                    # materialized view refresh interval (5min)
SI_FEED_CACHE_TTL_SECONDS=60                      # SI feed cache TTL

# ── Bridge View (Phase 8) ─────────────────────────────────────────────
EMPIRE_BRIDGE_ENABLED=false                       # toggle /bridge route
EMPIRE_BRIDGE_LISTEN_MODE=continuous              # continuous | push-to-talk

# ── Feature Flags ─────────────────────────────────────────────────────
DRY_RUN=                                          # set to "1" for dry-run mode
