# Empire AI · Predictive Revenue — Lead-gen & dispatch agent fleet
# All agents read their config from agent_config; cron only triggers.
# Live-mode agents (lead_converter, dispatch, contractor_outreach) write to outreach_log
# and trigger real SMS / dispatch emails on each run.

# 1. Scanner — every 30 min, on the hour
*/30 * * * * /bin/bash /root/empire-v49/agents/lead_scanner/cron.sh >> /root/empire-v49/logs/agent_lead_scanner.log 2>&1

# 2. Enricher — every 30 min, offset 5 min from scanner (avoids supabase contention)
5,35 * * * * /bin/bash /root/empire-v49/agents/lead_enricher/cron.sh >> /root/empire-v49/logs/agent_lead_enricher.log 2>&1

# 3. Converter — every 15 min, offset 10 min (live mode, fresh leads to push to Vonage)
10,25,40,55 * * * * /bin/bash /root/empire-v49/agents/lead_converter/cron.sh >> /root/empire-v49/logs/agent_lead_converter.log 2>&1

# 4. Dispatch — every 5 min, offset 2 min (YES replies need fast turnaround)
2,7,12,17,22,27,32,37,42,47,52,57 * * * * /bin/bash /root/empire-v49/agents/dispatch/cron.sh >> /root/empire-v49/logs/agent_dispatch.log 2>&1

# 5. Contractor outreach — every 4 hours, on the hour
0 */4 * * * /bin/bash /root/empire-v49/agents/contractor_outreach/cron.sh >> /root/empire-v49/logs/agent_contractor_outreach.log 2>&1

# 6. Backlinks monitoring — every 12 hours, on the hour
0 */12 * * * /bin/bash /root/empire-v49/agents/backlinks/cron.sh >> /root/empire-v49/logs/agent_backlinks.log 2>&1

# 7. B2B Lead Scraper — every 6 hours (Managed IT, Merchant Services, HR & Staffing)
# Discovers B2B companies via Google Places, scrapes websites for contacts,
# and inserts qualified leads into radar_targets for the pipeline.
0 */6 * * * cd /root/empire-v49 && python3 -m bots.b2b_lead_scraper >> /root/empire-v49/logs/agent_b2b_lead_scraper.log 2>&1

# 8. Prospector (upstream) — every 6h on :05. Runs bots/prospector.py across all
# configured metros + niches, writes to `prospects` table. prospector_bridge reads
# from `prospects` on :15. Without this, prospector_bridge has nothing to bridge
# and contractor_outreach has nothing to recruit.
5 */6 * * * /bin/bash /root/empire-v49/agents/prospector/cron.sh >> /root/empire-v49/logs/agent_prospector.log 2>&1

# 9. Retarget — every 6h on :07. Walks replied sequences, reactivates soft-replies.
# Conservative: skips DNC, already-active, STOP, YES, and phones with failed_send_count>=3.
7 */6 * * * /bin/bash /root/empire-v49/agents/retarget/cron.sh >> /root/empire-v49/logs/agent_retarget.log 2>&1

# 10. Warp Scout — every 6h on :50. Queries NOAA Storm Prediction Center,
# writes per-metro risk to storm_risk_log, alerts on Slight+ (rank>=4).
# Replaces the orphaned bots/storm_predictor.py while-loop daemon.
50 */6 * * * /bin/bash /root/empire-v49/agents/warp_scout/cron.sh >> /root/empire-v49/logs/agent_warp_scout.log 2>&1

# 11. Fee Watcher — every 6h on :55. Polls for settled-claim events.
# Disabled by default until a claim event source (webhook or polling) is wired.
55 */6 * * * /bin/bash /root/empire-v49/agents/fee_watcher/cron.sh >> /root/empire-v49/logs/agent_fee_watcher.log 2>&1

# 12. A/B Monitor — every 6h on :52. Polls /api/v1/ab-test/results and logs
# to agent_activity. Real reply rate builds over 24-72h after sends.
52 */6 * * * /root/sniper_env/bin/python3 /root/empire-v49/agents_ab_monitor.py >> /root/empire-v49/logs/agent_ab_monitor.log 2>&1

# 13. Settled Claim Monitor — every 6h on :54. Polls mock carrier
# for open claims and randomly settles 30% of them at 60-95% of
# asset_value. Drives fee_events chain end-to-end.
54 */6 * * * /root/sniper_env/bin/python3 /root/empire-v49/agents_settled_monitor.py >> /root/empire-v49/logs/agent_settled_monitor.log 2>&1

# 14. YouTube Shorts — daily at 09:00 UTC. Generates and renders one faceless
# Shorts video for Empire AI's channel. Kokoro TTS + WhisperX + FFmpeg.
# Dry-run by default (no upload). Set YT_PUBLISH=1 in env to enable upload.
0 9 * * * /bin/bash /root/empire-v49/agents/youtube_shorts/cron.sh >> /root/empire-v49/logs/agent_youtube_shorts.log 2>&1

# System Supervisor — daily 09:00 UTC. Catches cron/route/money/email breaks,
# posts to Telegram. Add to crontab with: cat agents/CRONTAB.fragment | crontab -
0 9 * * * cd /root/empire-v49 && /usr/bin/python3 -m agents.system_supervisor >> logs/agent_system_supervisor.log 2>&1

# Radar Asset Enricher — every 6h on :02. Backfills radar_targets.asset_value
# from ATTOM/RentCast (if keys set) or business-signal formula.
2 */6 * * * cd /root/empire-v49 && /usr/bin/python3 -m agents.radar_asset_enricher --limit 1000 >> logs/agent_radar_asset_enricher.log 2>&1
