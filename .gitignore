__pycache__/
hourly_digest.txt
hourly_digest.txt.tmp

# JS dependencies (SPA uses esm.sh imports — no build step)
node_modules/
package-lock.json

# Binary model + voice files (regenerated at runtime)
*.onnx
*.bin

# Generated outreach drafts
outreach_drafts/

# Security: never commit signing keys
private.key
*.pem

# Terraform — never commit state, plan files, or the user's tfvars
# (which holds hcloud_token + hetzner_dns_token in plain text)
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
infra/terraform/terraform.tfvars
infra/terraform/terraform.tfstate
infra/terraform/terraform.tfstate.backup
infra/terraform/*.tfplan
*.tfplan

# Runtime data (regenerated each session — never commit)
leads/*.json
logs/*.log
hub.log

# Backup files (created by editors, sed -i.bak, etc.)
*.bak
*.bak.*

# Local dev logs (created when the synthetic_brain runs in dev mode)
synthetic_brain.log

# Rendered/generated video templates (regenerated at runtime, large binaries)
templates/**/*.mp4
SESSION_*.md

# Local SQLite databases (storm scraper output, etc. — generated at runtime)
data/*.sqlite
data/*.sqlite-*

# Generated video + voiceover assets (regenerated per prospect, do not commit)
builds/**/*.mp4
builds/**/*.wav
builds/**/*.mp3
builds/**/*.png
builds/**/*.jpg

# Keep the directory structure (target_<name> folders) in git, just not the assets
!builds/**/
!builds/**/.gitkeep

# Scratch/debug/fix scripts (temporary — never commit)
_*.py
bbb_probe2.py
_*.sh
test-ledger/

# Obsidian vault per-user app config (theme, spellcheck, font prefs — not portable)
notes/.obsidian/
# autoresearch local artifacts
integrations/autoresearch/.venv/
integrations/autoresearch/results.tsv
integrations/autoresearch/__pycache__/
solana-meme-sniper/target/

# Third-party integrations (cloned repos — never commit)
integrations/
data/

# Graphify knowledge graph — generated, 22MB, regenerated on extract
# Do not commit — run `python3 -m graphify extract` to rebuild
graphify-out/
deploy/*/pg_data/
deploy/*/data/
deploy/*/superset_data/
deploy/*/assets/

# Generated video output
youtube_shorts_output/

# Screenshot artifacts
screenshots/
tmp_revenue_ledger.png
.env
