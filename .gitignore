__pycache__/
hourly_digest.txt
hourly_digest.txt.tmp

# JS dependencies (SPA uses esm.sh imports — no build step)
node_modules/
package-lock.json

# Binary model + voice files (regenerated at runtime)
*.onnx
*.bin

# Generated outreach drafts
outreach_drafts/

# Security: never commit signing keys
private.key
*.pem

# Terraform — never commit state, plan files, or the user's tfvars
# (which holds hcloud_token + hetzner_dns_token in plain text)
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
infra/terraform/terraform.tfvars
infra/terraform/terraform.tfstate
infra/terraform/terraform.tfstate.backup
infra/terraform/*.tfplan
*.tfplan

# Runtime data (regenerated each session — never commit)
leads/*.json
logs/*.log

# Backup files (created by editors, sed -i.bak, etc.)
*.bak
*.bak.*

# Local dev logs (created when the synthetic_brain runs in dev mode)
synthetic_brain.log

# Rendered/generated video templates (regenerated at runtime, large binaries)
templates/videos/*.mp4
