def get_pending_fees():
    res = sb.table("fee_events").select("*").eq("status", "pending").execute()
    return res.data or []

def get_seeded_contractors():
    res = sb.table("contractors").select("*").in_("email", SEEDED_CONTRACTORS).execute()
    return res.data or []

