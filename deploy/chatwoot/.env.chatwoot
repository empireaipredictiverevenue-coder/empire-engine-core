# Empire Chatwoot — Environment Configuration
# Copy to .env and fill in your values before running docker compose up
#
# ── Server URL ─────────────────────────────────────────────────────
FRONTEND_URL=https://chat.empire-ai.co.uk

# ── Database ────────────────────────────────────────────────────────
POSTGRES_PASSWORD=generate-a-strong-password-here
REDIS_PASSWORD=generate-another-strong-password-here

# ── Security ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=generate-a-long-random-string-here

# ── Facebook Messenger (REQUIRED for FB channel) ──────────────────
# Get these from https://developers.facebook.com → Your App → Settings → Basic
FB_APP_ID=your-facebook-app-id-here
FB_APP_SECRET=your-facebook-app-secret-here
# Create a random string — this is the handshake between Meta and your server
FB_VERIFY_TOKEN=a-random-verify-token-you-create

# ── SMTP (optional — for email notifications from Chatwoot) ────────
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=empire-ai.co.uk
MAILER_SENDER_EMAIL=notifications@empire-ai.co.uk
